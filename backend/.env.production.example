# Copy to backend/.env and replace every placeholder before deploying.
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com

# Use a pooled connection for runtime traffic and a direct connection for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:6543/DATABASE?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE?schema=public"

SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-private-password
SEED_DEMO_DATA=false

