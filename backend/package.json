{
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:prod": "node dist/prisma/seed.js",
    "test:regional": "node --env-file=.env tests/test-regional-admin.js",
    "test:field": "node --env-file=.env tests/test-field-staff.js",
    "test:rbac": "node --env-file=.env tests/test-rbac.js",
    "test:security": "node --env-file=.env tests/test-security.js",
    "test:concurrent": "node --env-file=.env tests/test-multiuser-concurrent.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "argon2": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "prisma": "^6.19.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cookie-parser": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
