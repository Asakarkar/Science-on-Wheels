# Local development only. Never commit backend/.env.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=

# Use a local PostgreSQL database for development.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/science_on_wheels?schema=public
DIRECT_URL=postgresql://postgres:change-me@localhost:5432/science_on_wheels?schema=public

# Replace both values before running the application.
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_NAME=Super Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-private-password-at-least-12-characters

# Set to true only when the optional CSV data files are available.
SEED_DEMO_DATA=false
