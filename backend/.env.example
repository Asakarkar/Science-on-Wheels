NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=

# PostgreSQL connection strings used by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Use a random secret with at least 32 characters and unique bootstrap credentials.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SEED_DEMO_DATA=false

# Optional integrations; leave unset when unused.
RESEND_API_KEY=
OPENAI_API_KEY=
SENTRY_DSN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
REDIS_URL=
REDIS_PASSWORD=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
GOOGLE_MAPS_API_KEY=
GEOAPIFY_API_KEY=
TRACCAR_BASE_URL=
TRACCAR_USERNAME=
TRACCAR_PASSWORD=
TRACKING_ENABLED=false
TRACKING_POLICY=active_trip_only
TRACKING_PRIMARY_SOURCE=device
TRACKING_FALLBACK_SOURCE=phone
LIVE_LOCATION_STALE_AFTER_SECONDS=60
PHONE_LOCATION_UPDATE_INTERVAL_SECONDS=10
PHONE_LOCATION_MAX_AGE_SECONDS=30
LOCATION_HISTORY_RETENTION_DAYS=30
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
