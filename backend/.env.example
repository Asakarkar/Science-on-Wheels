# Science on Wheels — backend environment template
# Copy to backend/.env for local development. Never commit .env.
# All values below are placeholders, not production credentials.

# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Supabase
# DATABASE_URL: Transaction / Session pooler URL (port 6543) with pgbouncer=true
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Direct database connection URL (port 5432) used for Prisma migrations
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Authentication / database-backed sessions
SESSION_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Bootstrap Super Admin (used by the seed/bootstrap workflow)
BOOTSTRAP_ADMIN_NAME="Super Admin"
BOOTSTRAP_ADMIN_EMAIL=admin@scienceonwheels.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PRIVATE_PASSWORD

# Optional integrations (only active if corresponding code is configured)
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
SENTRY_DSN=REPLACE_WITH_BACKEND_SENTRY_DSN

# Optional Redis (not currently required by the application)
REDIS_URL=REPLACE_WITH_REDIS_URL
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Optional AWS S3 file storage (not currently required by the application)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET=REPLACE_WITH_S3_BUCKET_NAME

# Optional legacy Google Maps (not required by the MapLibre/Geoapify plan)
GOOGLE_MAPS_API_KEY=REPLACE_IF_ACTUALLY_USED

# Planned route calculation — Geoapify
# Configuration only until route-calculation integration is implemented.
GEOAPIFY_API_KEY=REPLACE_WITH_GEOAPIFY_API_KEY

# Planned dedicated GPS device integration — Traccar
# Configure only after deploying a secured Traccar server and compatible device.
TRACCAR_BASE_URL=http://localhost:8082
TRACCAR_USERNAME=REPLACE_WITH_TRACCAR_USERNAME
TRACCAR_PASSWORD=REPLACE_WITH_TRACCAR_PASSWORD

# Proposed tracking policy settings; enforcement requires application integration.
TRACKING_ENABLED=false
TRACKING_POLICY=active_trip_only
TRACKING_PRIMARY_SOURCE=device
TRACKING_FALLBACK_SOURCE=phone
LIVE_LOCATION_STALE_AFTER_SECONDS=60
PHONE_LOCATION_UPDATE_INTERVAL_SECONDS=10
PHONE_LOCATION_MAX_AGE_SECONDS=30
LOCATION_HISTORY_RETENTION_DAYS=30

# Optional Firebase Cloud Messaging / Web Push (not currently required)
FIREBASE_PROJECT_ID=REPLACE_IF_USED
FIREBASE_CLIENT_EMAIL=REPLACE_IF_USED
FIREBASE_PRIVATE_KEY=REPLACE_IF_USED
FIREBASE_WEB_API_KEY=REPLACE_IF_USED
FIREBASE_MESSAGING_SENDER_ID=REPLACE_IF_USED
FIREBASE_APP_ID=REPLACE_IF_USED
FIREBASE_VAPID_KEY=REPLACE_IF_USED
