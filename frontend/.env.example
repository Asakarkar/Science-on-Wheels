# Science on Wheels — frontend environment template
# Copy to frontend/.env. Every VITE_* value is bundled into browser code;
# never put database passwords, session secrets or private API keys here.

# Current API client
VITE_API_BASE_URL=http://localhost:5000/api

# Optional; only if frontend Sentry initialization is implemented
VITE_SENTRY_DSN=REPLACE_WITH_FRONTEND_SENTRY_DSN

# Planned MapLibre integration: provider style JSON URL.
# Any key embedded in this URL is browser-visible; restrict it at the provider.
VITE_MAP_STYLE_URL=REPLACE_WITH_MAP_STYLE_URL

# Not required for MapLibre; retain only if existing code uses Google Maps.
VITE_GOOGLE_MAPS_API_KEY=REPLACE_IF_ACTUALLY_USED
